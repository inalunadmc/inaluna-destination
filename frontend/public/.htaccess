# SPA fallback for Hostinger / Apache
# Ensures hash-based navigation and direct URL hits both resolve to index.html

RewriteEngine On
RewriteBase /

# Preserve real files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else -> index.html (lets React Router handle it client-side)
RewriteRule ^ index.html [L]
